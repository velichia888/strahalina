generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserStatus {
  active
  suspended
}

enum ListingType {
  property
  investment
}

enum ListingStatus {
  active
  pending
  sold
}

/// general: a plain admin post (the original Updates feed).
/// market_insight / content: same real Update row, just tagged so the
/// iOS Updates feed can offer the mockup's "Market Insights" / "Content
/// Hub" filter tabs without inventing a second content system or any
/// fabricated articles/videos.
enum UpdateCategory {
  general
  market_insight
  content
}

/// listing: tied to one property/investment (the original flow).
/// consultation / investor_inquiry: a general, not-listing-specific
/// thread started from the mockup's "Book a Consultation" / "Investor
/// Inquiry" forms — same real Conversation/Message system, just
/// unattached to a listing and tagged so the UI can label it correctly.
enum ConversationKind {
  listing
  consultation
  investor_inquiry
}

model User {
  id           String     @id @default(uuid())
  email        String     @unique
  passwordHash String
  displayName  String
  status       UserStatus @default(active)
  tokenVersion Int        @default(0)
  /// Gates listing/update writes and admin-wide conversation access
  /// (backend/src/middleware/requireAdmin.ts). No signup path can set
  /// this — only ever flipped by prisma/seed.ts's bootstrap, same
  /// pattern as the other apps this session.
  isAdmin      Boolean    @default(false)
  createdAt    DateTime   @default(now())

  conversationsAsBuyer Conversation[]
  messages             Message[]
  updates              Update[]

  @@map("users")
}

model Listing {
  id          String        @id @default(uuid())
  title       String
  description String
  type        ListingType
  status      ListingStatus @default(active)
  /// Whole-dollar price, stored as cents to avoid float rounding.
  priceCents  Int
  location    String
  /// Couple-entered label/value pairs (e.g. "Cap rate" -> "6.2%").
  /// Never computed or invented by the server — see docs/MVP_SCOPE.md.
  keyFacts    Json          @default("[]")
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  photos        ListingPhoto[]
  conversations Conversation[]
  updates       Update[]

  @@map("listings")
}

model ListingPhoto {
  id         String  @id @default(uuid())
  listingId  String
  listing    Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  storageKey String
  order      Int     @default(0)

  @@index([listingId])
  @@map("listing_photos")
}

model Update {
  id              String         @id @default(uuid())
  authorId        String
  author          User           @relation(fields: [authorId], references: [id])
  body            String
  photoStorageKey String?
  /// Optional external link (e.g. YouTube) for the mockup's "Content
  /// Hub" video framing -- never a real hosted video, just a link the
  /// admin attaches to a real post.
  externalVideoUrl String?
  category        UpdateCategory @default(general)
  listingId       String?
  listing         Listing?       @relation(fields: [listingId], references: [id], onDelete: SetNull)
  createdAt       DateTime       @default(now())

  @@index([createdAt])
  @@index([category])
  @@map("updates")
}

// Unlike myemptycloset/Car Hopping (peer-to-peer marketplaces where
// every listing has one specific seller), Strahalina's listings are
// jointly managed by the couple via the isAdmin flag, not owned by an
// individual user. So a Conversation has a specific buyer but no
// specific "seller" — any admin can see and post to any conversation.
// See requireAdminOrConversationBuyer in conversation.controller.ts.
//
// listingId is optional to support general "Book a Consultation" /
// "Investor Inquiry" threads that aren't about one specific property
// (kind = consultation / investor_inquiry). Postgres unique indexes
// treat NULL as distinct from every other value, so
// @@unique([listingId, buyerId]) still enforces "one thread per buyer
// per listing" for kind = listing while placing no limit on how many
// listingId = null (general) conversations a buyer can start.
model Conversation {
  id        String           @id @default(uuid())
  kind      ConversationKind @default(listing)
  listingId String?
  listing   Listing?         @relation(fields: [listingId], references: [id], onDelete: Cascade)
  buyerId   String
  buyer     User             @relation(fields: [buyerId], references: [id])
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  messages Message[]

  @@unique([listingId, buyerId])
  @@map("conversations")
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User         @relation(fields: [senderId], references: [id])
  body           String
  createdAt      DateTime     @default(now())
  readAt         DateTime?

  @@index([conversationId])
  @@map("messages")
}
