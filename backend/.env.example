DATABASE_URL=postgresql://user:password@localhost:5432/strahalina
DIRECT_URL=postgresql://user:password@localhost:5432/strahalina

PORT=4003
CORS_ORIGIN=*

JWT_ACCESS_SECRET=replace-with-a-long-random-string
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=replace-with-a-different-long-random-string
JWT_REFRESH_TTL=30d

STORAGE_PROVIDER=local
LOCAL_STORAGE_SIGNING_SECRET=replace-with-a-long-random-string

# Only needed when running `npm run seed` to bootstrap the one admin
# account (backend/prisma/seed.ts) — not read by the running server.
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=

# Only needed when STORAGE_PROVIDER=s3
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=
